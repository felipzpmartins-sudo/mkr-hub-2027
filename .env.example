# PostgreSQL exclusivo do HUB. Não use a base dos sistemas externos.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mkr_hub?schema=public"
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Em Railway, habilite somente atrás do proxy confiável da plataforma.
AUTH_TRUST_HOST="true"
# Somente habilite se o proxy substituir x-forwarded-for com o IP real.
TRUST_PROXY="false"
# Integração do Central de Compras / Supabase. Configure os valores reais
# somente no ambiente do Railway; não versione segredos.
CENTRAL_PURCHASES_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
CENTRAL_PURCHASES_SUPABASE_ANON_KEY="SUA_CHAVE_PUBLICA_DO_SUPABASE"
# Origem exata (protocolo e domínio) onde o front-end do Central será publicado.
CENTRAL_PURCHASES_ORIGIN="https://central-compras.exemplo.com"
# Integração do Central de Marketing / Supabase. A conta corporativa é
# reaproveitada no acesso único quando as mesmas credenciais existirem nele.
CENTRAL_MARKETING_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
CENTRAL_MARKETING_SUPABASE_ANON_KEY="SUA_CHAVE_PUBLICA_DO_SUPABASE"
CENTRAL_MARKETING_ORIGIN="https://central-marketing.exemplo.com"
# API e origem do Maker Wallet. O Hub usa a API apenas para validar as mesmas
# credenciais corporativas e entrega um ticket de uso único ao front-end.
MAKER_WALLET_API_URL="https://maker-wallet.exemplo.com"
MAKER_WALLET_ORIGIN="https://wallet.exemplo.com"
# Código de integração guardado somente no ambiente do HUB. Ele permite criar
# automaticamente a conta local do Wallet sem revelar convite ou senha ao usuário.
MAKER_WALLET_REGISTRATION_INVITE_CODE=""
# API e origem do Central de Vídeos. As contas existentes são verificadas
# nele e o Hub só entrega um ticket de uso único ao front-end.
CENTRAL_VIDEO_API_URL="https://central-video.exemplo.com"
CENTRAL_VIDEO_ORIGIN="https://central-video.exemplo.com"
# Chave compartilhada exclusivamente entre o backend do Central de Vídeos e o HUB.
CENTRAL_VIDEO_HUB_PROVISION_KEY=""
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HUB_SSO_ENCRYPTION_KEY=""
# Usadas apenas pelo comando admin:create; remova após o provisionamento.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
