// Laboratory database contract for the Central de Compras API.
// This file is intentionally not a migration and must not be applied to a real database.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

/// The supplied ID is always the canonical identity. During a future import it
/// must receive the existing auth.users UUID; it has no generated default.
model User {
  id                String               @id @db.Uuid
  email             String               @unique
  passwordHash      String?              @map("password_hash")
  fullName          String?              @map("full_name")
  phone             String?
  status            UserStatus           @default(ACTIVE)
  mustResetPassword Boolean              @default(false) @map("must_reset_password")
  lastLoginAt       DateTime?            @map("last_login_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  profile           Profile?
  roles             UserRole[]
  sessions          AuthSession[]
  passwordResets    PasswordResetToken[]
  solicitations     Solicitation[]
  uploadedFiles     Attachment[]         @relation("AttachmentUploader")
  statusChanges     StatusHistory[]      @relation("StatusHistoryChangedBy")
  approvalsMade     Approval[]           @relation("ApprovalActor")

  @@map("users")
}

/// Only a hash of a future session token may be stored; never persist the raw token.
model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Only a hash of a future password-reset token may be stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Compatibility/profile data. Profile.id is not an authentication identity.
model Profile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  fullName   String?  @map("full_name")
  phone      String?
  department String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// Role values remain strings until the legacy role matrix is formally consolidated.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

/// Core request shape only. Legacy-specific fields and allowed status values are
/// deliberately deferred until the source schema and import plan are approved.
model Solicitation {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  requesterName      String          @map("requester_name")
  requesterEmail     String?         @map("requester_email")
  requesterPhone     String?         @map("requester_phone")
  requestType        String          @map("request_type")
  status             String          @default("pending")
  approvalStatus     String?         @map("approval_status")
  approvedCount      Int             @default(0) @map("approved_count")
  releasedAt         DateTime?       @map("released_at")
  stockStatus        String?         @map("stock_status")
  generalDescription String?         @map("general_description")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  user               User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  attachments        Attachment[]
  statusHistory      StatusHistory[]
  approvals          Approval[]

  @@index([userId])
  @@index([status])
  @@map("solicitations")
}

/// Minimal approval record for the laboratory workflow. One actor can register
/// one current decision per solicitation, matching the legacy uniqueness rule.
model Approval {
  id             String       @id @default(uuid()) @db.Uuid
  solicitationId String       @map("solicitation_id") @db.Uuid
  approverId     String       @map("approver_id") @db.Uuid
  status         String       @default("pending")
  justification  String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  solicitation   Solicitation @relation(fields: [solicitationId], references: [id], onDelete: Cascade)
  approver       User         @relation("ApprovalActor", fields: [approverId], references: [id], onDelete: Restrict)

  @@unique([solicitationId, approverId])
  @@index([solicitationId])
  @@index([approverId])
  @@map("approvals")
}

model Attachment {
  id             String       @id @default(uuid()) @db.Uuid
  solicitationId String       @map("solicitation_id") @db.Uuid
  uploadedBy     String       @map("uploaded_by") @db.Uuid
  attachmentType String       @map("attachment_type")
  fileName       String       @map("file_name")
  filePath       String       @map("file_path")
  fileSize       Int?         @map("file_size")
  mimeType       String?      @map("mime_type")
  createdAt      DateTime     @default(now()) @map("created_at")
  solicitation   Solicitation @relation(fields: [solicitationId], references: [id], onDelete: Cascade)
  uploader       User         @relation("AttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([solicitationId])
  @@index([uploadedBy])
  @@map("attachments")
}

model StatusHistory {
  id             String       @id @default(uuid()) @db.Uuid
  solicitationId String       @map("solicitation_id") @db.Uuid
  changedBy      String       @map("changed_by") @db.Uuid
  oldStatus      String?      @map("old_status")
  newStatus      String       @map("new_status")
  justification  String?
  createdAt      DateTime     @default(now()) @map("created_at")
  solicitation   Solicitation @relation(fields: [solicitationId], references: [id], onDelete: Cascade)
  changedByUser  User         @relation("StatusHistoryChangedBy", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([solicitationId])
  @@index([changedBy])
  @@map("status_history")
}

/// Approvers are still addressed by email. An optional userId may be introduced
/// only in a later, approved data-cleanup step; it is intentionally not added yet.
model Approver {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("approvers")
}
